{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "supabase/functions",
    "android",
    "ios",
    "playwright-report",
    "exports",
    "stitch_nura_onboarding",
    "supabase-migrations",
    "ADMIN_SUPPORT_TEMPLATE.tsx"
  ],
  "include": [
    "src",
    "vite.config.ts",
    "capacitor.config.ts"
  ]
}
