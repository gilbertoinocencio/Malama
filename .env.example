# NURA Environment Variables
# Copy this file to .env.local and fill in your values

# Caramel AI — a chave NÃO vai no frontend (o prefixo VITE_ exporia no bundle).
# O app chama a Edge Function `caramel-proxy`; configure no Supabase:
# supabase secrets set CARAMELO_API_URL=... CARAMELO_API_KEY=...

# Supabase Configuration
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Telemedicine — WebRTC TURN Server
# Preferencial: Cloudflare Realtime TURN via Edge Function `turn-credentials`
# (credenciais efêmeras; a chave NÃO vai no frontend). Configure via:
#   supabase secrets set CLOUDFLARE_TURN_KEY_ID=... CLOUDFLARE_TURN_API_TOKEN=...
# Fallback estático (qualquer provedor) — só se não usar Cloudflare:
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Telemedicina — Caramel é o provedor principal; Claude é somente fallback.
# Configure o fallback via: supabase secrets set ANTHROPIC_API_KEY=...

# Application URL (used in prescription verification links)
VITE_APP_URL=https://nura.app

# Email Notifications (Resend): server-side apenas (Edge Functions).
# Configure via: supabase secrets set RESEND_API_KEY=...

# Community — UUID do usuário sistema que publica a Pergunta do Dia
# Crie um usuário "sistema" no Supabase Auth e cole o UUID aqui
VITE_COMMUNITY_SYSTEM_USER_ID=

# ─── Strava Integration ───────────────────────────────────────────────────────
# Frontend (prefixo VITE_ — seguro expor, é o Client ID público)
VITE_STRAVA_CLIENT_ID=

# App URL (usado como redirect_uri e base para deep links)
VITE_APP_URL=https://nura-seven.vercel.app

# Segredos das Edge Functions — NUNCA usar prefixo VITE_ (ficam apenas no servidor)
#
# Este arquivo é versionado. Nada de valor real aqui — nem como "exemplo".
#
# Integração Strava em DESCOMISSIONAMENTO desde 01/09/2026 (o app passou a
# cobrir atividade física por Apple HealthKit e Google Health Connect).
# strava-oauth, strava-oauth-callback e strava-webhook já foram desligadas
# (só devolvem 410) — quem ainda tem o Strava conectado de antes continua
# sincronizando via strava-sync/strava-refresh-token até a remoção
# completa (tarefa separada, ver docs/security-audit/DEPLOY.md), que ainda
# dependem de STRAVA_CLIENT_ID/STRAVA_CLIENT_SECRET. Não configure
# STRAVA_VERIFY_TOKEN nem STRAVA_WEBHOOK_SECRET de novo — nada mais os lê.
#
# Configure via: supabase secrets set STRAVA_CLIENT_ID=... STRAVA_CLIENT_SECRET=...
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Google Fit foi removido (API descontinuada pelo Google em 2026).
# No Android, a integração de fitness usa Google Health Connect (on-device, sem OAuth).

# ─── Asaas Payment Gateway (Edge Functions — NÃO usar prefixo VITE_) ───────────
# Configure via: supabase secrets set ASAAS_API_KEY=xxx ASAAS_WEBHOOK_SECRET=yyy ASAAS_ENV=sandbox
#
# ASAAS_API_KEY       → Chave de API do Asaas (Configurações → Integrações → API)
# ASAAS_WEBHOOK_SECRET → Token configurado no webhook do Asaas para validar autenticidade
# ASAAS_ENV           → 'sandbox' (testes) ou 'production' (produção)
#
# Estas variáveis NÃO vão para o .env.local pois são segredos das Edge Functions.
# Para desenvolvimento local, crie supabase/functions/.env:
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=
ASAAS_ENV=sandbox
